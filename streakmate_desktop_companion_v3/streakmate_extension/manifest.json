{
  "manifest_version": 3,
  "name": "StreakMate \u2014 LeetCode Streak Buddy",
  "version": "0.3.0",
  "description": "Local-first LeetCode streak tracker with desktop companion sync.",
  "permissions": [
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "StreakMate \u2014 click to open LeetCode",
    "default_icon": {
      "16": "icons/chill16.png",
      "32": "icons/chill32.png",
      "48": "icons/chill48.png",
      "128": "icons/chill128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}